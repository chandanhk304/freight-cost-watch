# Template for .env. Copy it to .env and fill in the key:
#     copy example.env .env
#
# A key is only needed for FRESH LLM calls (run.py --no-cache, repro_check.py, extract_notes.py).
# Without one, everything still runs:
#   run.py            replays the committed outputs/llm_cache.json (the exact run of record)
#   run.py --no-llm   uses template explanations (numbers, flags and cited notes are identical)
#
# Get a free key at https://console.groq.com/keys (model used: openai/gpt-oss-20b, open-weight).
# Never commit .env: it is listed in .gitignore. This example file contains no secrets.
GROQ_API_KEY=
